<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>OttoMapper.Mapping</PackageId>
    <Description>Fast object mapper with AutoMapper-like configuration, explicit map validation, nested mapping, collection mapping, and performance-focused runtime delegates.</Description>
    <PackageReleaseNotes>Fix (ProjectTo): collection projections no longer emit null guards, which EF Core could not translate cleanly — collections were loaded a second time as whole entities, duplicating joins and pulling columns outside the DTO into the SQL. New opt-in MapperConfiguration.ProjectionNullGuards switch for in-memory (LINQ-to-Objects) projections over null-carrying sources.</PackageReleaseNotes>
    <Version>1.3.0</Version>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\docs\README.md" Pack="true" PackagePath="" Link="README.md" />
    <None Include="..\LICENSE" Pack="true" PackagePath="" Link="LICENSE" />
  </ItemGroup>
</Project>