<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The generator assembly itself targets netstandard2.0 so it can run in any consumer compiler. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>OttoMapper.Generator</PackageId>
    <Description>Optional Roslyn source generator for OttoMapper that compiles convention-based maps at compile time. Reference as an analyzer (PrivateAssets=all) alongside OttoMapper.Mapping. Without this package, OttoMapper uses its runtime expression-tree path unchanged.</Description>
    <PackageReleaseNotes>Initial source generator release. Generates static convention maps at compile time for types decorated with [AutoMap(typeof(TSource))]. Best-effort AOT; falls back to runtime for non-statically-resolvable or customized maps. Optional analyzer package — OttoMapper uses its runtime expression-tree path unchanged without it.</PackageReleaseNotes>
    <Version>1.2.0</Version>
    <!-- The generator is loaded by the compiler as an analyzer, not referenced as a library. -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <DevelopmentDependency>true</DevelopmentDependency>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Release-tracking analyzer rule is not applicable to a non-analyzer generator; silence it. -->
    <NoWarn>RS2008</NoWarn>
    <!-- Analyzer packages legitimately have no lib/ref assets. -->
    <NoWarn>NU5128</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- Ship the generator assembly as the analyzer asset (classic, SDK-version-independent wiring). -->
    <None Include="$(TargetDir)$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="$(TargetDir)$(AssemblyName).pdb" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\docs\README.md" Pack="true" PackagePath="" Link="README.md" />
    <None Include="..\LICENSE" Pack="true" PackagePath="" Link="LICENSE" />
  </ItemGroup>
</Project>